NEXT_PUBLIC_SANITY_PROJECT_ID=gn3kobnn
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
NEXT_PUBLIC_SITE_URL=https://eliterealtypr.com

# Optional temporary public lock.
# When enabled, visitors see /under-construction unless they use:
# https://eliterealtypr.com/?clientAccess=your-secret
# Defaults in production code: enabled with elite-preview-2026.
SITE_LOCK_ENABLED=true
SITE_LOCK_SECRET=elite-preview-2026

SANITY_WEBHOOK_SECRET=replace-with-sanity-webhook-secret

# Contact form email delivery via Resend.
# CONTACT_EMAIL_FROM must be a verified sender/domain in Resend for production.
RESEND_API_KEY=
CONTACT_EMAIL_TO=info@eliterealtypr.com
CONTACT_EMAIL_FROM=Elite Realty <onboarding@resend.dev>
